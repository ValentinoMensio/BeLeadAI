{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/analyze-enqueue.request.schema.json",
  "title": "POST /ext/v2/analyze/enqueue request",
  "type": "object",
  "required": ["usernames", "batch_size", "idempotency_key", "idempotency_version"],
  "properties": {
    "usernames": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "batch_size": { "type": ["integer", "number"], "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "idempotency_version": { "type": ["integer", "number"], "const": 2 }
  },
  "additionalProperties": false
}
