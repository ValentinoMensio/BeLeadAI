{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/send-ws-tasks.event.schema.json",
  "title": "Send websocket pushed tasks event",
  "type": "object",
  "required": ["type", "items"],
  "properties": {
    "type": {
      "type": "string",
      "const": "tasks"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["job_id", "task_id", "lease_proof", "payload"],
        "properties": {
          "job_id": { "type": "string" },
          "task_id": { "type": "string" },
          "lease_proof": { "type": "string" },
          "dest_username": { "type": ["string", "null"] },
          "payload": {
            "type": "object",
            "properties": {
              "target_username": { "type": ["string", "null"] },
              "message_template": { "type": ["string", "null"] },
              "message": { "type": ["string", "null"] },
              "dry_run": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
