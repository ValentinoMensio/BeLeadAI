  "title": "Jobs websocket ping event",
  "type": "object",
  "required": ["type", "event_id"],
  "properties": {
    "type": {
      "type": "string",
      "const": "ping"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
