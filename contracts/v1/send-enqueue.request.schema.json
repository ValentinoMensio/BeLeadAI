{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/send-enqueue.request.schema.json",
  "title": "POST /ext/v2/send/enqueue request",
  "type": "object",
  "required": [
    "from_account",
    "usernames",
    "message_template_hash",
    "idempotency_key",
    "idempotency_version",
    "recipient_idempotency_keys",
    "source_job_id",
    "dry_run",
    "use_ai"
  ],
  "properties": {
    "from_account": { "type": "string", "minLength": 1 },
    "usernames": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "message_template": { "type": "string" },
    "message_template_hash": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "idempotency_version": { "type": ["integer", "number"], "const": 2 },
    "recipient_idempotency_keys": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "source_job_id": { "type": "string", "minLength": 1 },
    "dry_run": { "type": "boolean" },
    "use_ai": { "type": "boolean" },
    "client_prompt": { "type": "string" }
  },
  "additionalProperties": false
}
