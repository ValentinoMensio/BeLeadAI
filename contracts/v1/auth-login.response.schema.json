{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v1/auth-login.response.schema.json",
  "title": "POST /api/auth/login success response",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["access_token", "refresh_token"],
      "properties": {
        "access_token": {
          "type": "string",
          "minLength": 1
        },
        "refresh_token": {
          "type": "string",
          "minLength": 1
        },
        "jwt_expires_at": {
          "type": ["number", "integer"]
        },
        "access_expires_at": {
          "type": ["number", "integer"]
        },
        "device_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
