        "source_kind": {
          "type": ["string", "null"]
        },
        "total": {
          "type": ["number", "integer", "null"]
        },
        "pending_count": {
          "type": ["number", "integer", "null"]
        },
        "matched_count": {
          "type": ["number", "integer", "null"]
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": ["string", "null"]
        },
